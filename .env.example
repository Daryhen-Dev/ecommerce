# Local development only. Never use these credentials in production.
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5433/ecommerce?schema=public"

# Admin panel: one shared password, no user accounts (see README: Admin panel).
# Password typed on /admin/login.
ADMIN_PASSWORD="admin-demo-password"
# Signing key for the `admin_session` cookie (HMAC-SHA256). Required: without
# it the panel refuses to sign sessions and /admin shows a configuration error.
# Generate a long random value anywhere the app is shared:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="admin-demo-secret-change-me-32-chars-min"
